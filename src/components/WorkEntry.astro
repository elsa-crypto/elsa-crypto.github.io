---
import type { WorkEntry } from "../data/projects";

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const hasDetails = (entry.items?.length ?? 0) > 0;
---

<div class="border-b border-line py-6 last:border-b-0">
  <div class="flex flex-wrap items-baseline gap-x-3">
    <h3 class="font-serif text-[1.5rem] leading-none text-ink">{entry.title}</h3>
    {
      entry.role && (
        <span class="font-sans text-sm text-accent">{entry.role}</span>
      )
    }
  </div>

  <p class="mt-2 max-w-prose text-muted">{entry.description}</p>

  {
    hasDetails && (
      <details class="group mt-3">
        <summary class="prose-link inline-flex cursor-pointer list-none items-center text-sm text-muted marker:content-['']">
          <span class="transition-transform group-open:rotate-90">›</span>
          <span class="ml-1.5 group-open:hidden">what this looks like</span>
          <span class="ml-1.5 hidden group-open:inline">show less</span>
        </summary>
        <ul class="mt-3 grid grid-cols-1 gap-x-6 gap-y-1 text-[0.95rem] text-ink sm:grid-cols-2">
          {entry.items!.map((item) => (
            <li class="flex gap-2">
              <span class="text-faint">—</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        {entry.placeholders && entry.placeholders.length > 0 && (
          <p class="mt-4 text-[0.85rem] text-faint italic">
            metrics shown once verified: {entry.placeholders.join("  ·  ")}
          </p>
        )}
      </details>
    )
  }
</div>
