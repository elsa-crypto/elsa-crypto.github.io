---
// Renders public Instagram posts/reels as playable embeds.
// Add links in src/data/instagram.ts.
import { instagramPosts } from "../data/instagram";

const hasPosts = instagramPosts.length > 0;
---

{
  hasPosts ? (
    <div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2">
      {instagramPosts.map((post) => (
        <figure class="m-0">
          {post.caption && (
            <figcaption class="eyebrow mb-2">{post.caption}</figcaption>
          )}
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={post.url}
            data-instgrm-version="14"
            style="margin:0;width:100%;max-width:540px;"
          >
            <a href={post.url}>view on instagram →</a>
          </blockquote>
        </figure>
      ))}
    </div>
  ) : (
    <p class="max-w-prose text-muted italic">
      instagram projects coming soon.
    </p>
  )
}

{/* Instagram's embed script turns the blockquotes above into playable cards. */}
{
  hasPosts && (
    <script is:inline async src="https://www.instagram.com/embed.js" />
  )
}
