---
// Renders public Instagram posts/reels as self-contained, playable iframe
// cards (no external script, so they never fall back to a plain link).
// Add links in src/data/instagram.ts.
import { instagramPosts } from "../data/instagram";

const hasPosts = instagramPosts.length > 0;

// Turn a permalink into its embeddable URL: .../reel/ID/  ->  .../reel/ID/embed
const toEmbed = (url: string) => `${url.endsWith("/") ? url : url + "/"}embed`;
---

{
  hasPosts ? (
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {instagramPosts.map((post) => (
        <figure class="m-0">
          {post.caption && (
            <figcaption class="eyebrow mb-2">{post.caption}</figcaption>
          )}
          <div class="instagram-card overflow-hidden rounded-xl border border-line bg-white">
            <iframe
              src={toEmbed(post.url)}
              title={post.caption ?? "instagram reel"}
              class="block w-full"
              loading="lazy"
              scrolling="no"
              frameborder="0"
              allowtransparency="true"
              allowfullscreen
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
            />
          </div>
        </figure>
      ))}
    </div>
  ) : (
    <p class="max-w-prose text-muted italic">instagram projects coming soon.</p>
  )
}

<style>
  /* Height of the embed card. Instagram's reel embed renders the video plus a
     header/footer; this fits it without an inner scrollbar. */
  .instagram-card iframe {
    height: 500px;
  }
</style>
