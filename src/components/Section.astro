---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---

<section id={id} class="mt-14 scroll-mt-24 border-t border-line pt-10">
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="mb-6 text-[1.7rem] sm:text-[2rem]">{title}</h2>
  <slot />
</section>
