---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---

<section id={id} class="mt-12 scroll-mt-24 border-t border-line pt-8">
  {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
  <h2 class="mb-5 text-[1.08rem]">{title}</h2>
  <slot />
</section>
