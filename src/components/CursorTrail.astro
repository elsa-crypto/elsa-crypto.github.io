---
// Tiny nailongs trail behind the cursor and fade out.
// Desktop/mouse only, and disabled for reduced-motion.
---

<script>
  const fine = window.matchMedia("(pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fine && !reduce) {
    const AR = 544 / 917; // nailong.png is portrait
    let lastX = 0;
    let lastY = 0;
    let primed = false;

    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType && e.pointerType !== "mouse") return;
        if (!primed) {
          lastX = e.clientX;
          lastY = e.clientY;
          primed = true;
          return;
        }
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        // only drop a nailong every ~48px of movement (keeps it sparse)
        if (dx * dx + dy * dy < 48 * 48) return;
        lastX = e.clientX;
        lastY = e.clientY;

        const h = 26 + Math.random() * 12;
        const w = h * AR;
        const img = document.createElement("img");
        img.src = "/nailong.png";
        img.alt = "";
        img.style.cssText = `position:fixed;left:${e.clientX}px;top:${e.clientY}px;width:${w}px;height:${h}px;margin:${-h / 2}px 0 0 ${-w / 2}px;pointer-events:none;z-index:15;will-change:transform,opacity;`;
        document.body.appendChild(img);

        const drift = (Math.random() - 0.5) * 34;
        const rot = (Math.random() - 0.5) * 90;
        const anim = img.animate(
          [
            { transform: "translate(0,0) scale(1) rotate(0deg)", opacity: 0.9 },
            {
              transform: `translate(${drift}px,${22 + Math.random() * 22}px) scale(.4) rotate(${rot}deg)`,
              opacity: 0,
            },
          ],
          { duration: 820 + Math.random() * 380, easing: "ease-out" },
        );
        anim.onfinish = () => img.remove();
      },
      { passive: true },
    );
  }
</script>
