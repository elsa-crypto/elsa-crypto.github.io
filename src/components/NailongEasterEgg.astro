---
// A tiny clickable nailong tucked next to the socials. Click it and a swarm
// bursts across the screen. Pure fun, no dependencies.
---

<button
  id="nailong-trigger"
  type="button"
  aria-label="surprise me"
  class="inline-flex shrink-0 align-middle transition-transform duration-150 hover:scale-110 active:scale-90"
>
  <img src="/nailong.png" width="26" height="44" alt="" draggable="false" />
</button>

<script>
  const trigger = document.getElementById("nailong-trigger");
  // nailong.png is portrait — keep its aspect (width / height)
  const AR = 544 / 917;
  trigger?.addEventListener("click", () => {
    const r = trigger.getBoundingClientRect();
    const ox = r.left + r.width / 2;
    const oy = r.top + r.height / 2;
    const N = 44;
    for (let i = 0; i < N; i++) {
      const img = document.createElement("img");
      img.src = "/nailong.png";
      img.alt = "";
      const h = 54 + Math.random() * 64;
      const w = h * AR;
      img.style.cssText = `position:fixed;left:${ox}px;top:${oy}px;width:${w}px;height:${h}px;margin:${-h / 2}px 0 0 ${-w / 2}px;pointer-events:none;z-index:9999;will-change:transform,opacity;`;
      document.body.appendChild(img);

      const angle = Math.random() * Math.PI * 2;
      const dist = 120 + Math.random() * 440;
      const dx = Math.cos(angle) * dist;
      const upY = -(140 + Math.random() * 280);
      const fallY = window.innerHeight + 240;
      const rot = (Math.random() - 0.5) * 900;
      const upDur = 380 + Math.random() * 220; // quick pop up
      const fallDur = (1100 + Math.random() * 1100) * 4; // drop ~4x slower
      const dur = upDur + fallDur;
      const upOffset = upDur / dur;

      const anim = img.animate(
        [
          { transform: "translate(0,0) scale(.3) rotate(0deg)", opacity: 0 },
          {
            transform: `translate(${dx * 0.5}px,${upY}px) scale(1) rotate(${rot * 0.4}deg)`,
            opacity: 1,
            offset: upOffset,
          },
          {
            transform: `translate(${dx}px,${fallY}px) scale(1) rotate(${rot}deg)`,
            opacity: 0,
          },
        ],
        { duration: dur, easing: "cubic-bezier(.18,.7,.35,1)" },
      );
      anim.onfinish = () => img.remove();
    }
  });
</script>
