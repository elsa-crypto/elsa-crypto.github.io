---
// Top nav. Each link is its own page/route.
const links = [
  { href: "/work", label: "work" },
  { href: "/media", label: "media" },
  { href: "/brain-dumps", label: "brain dumps" },
  { href: "/contact", label: "contact" },
];

// Normalize the current path (drop trailing slash) so the active link can be
// highlighted.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => path === href;
---

<header
  class="sticky top-0 z-20 border-b border-line/70 bg-paper/85 backdrop-blur-sm"
>
  <div
    class="mx-auto flex h-14 max-w-[820px] items-center justify-between gap-4 px-5 sm:px-8"
  >
    <a
      href="/"
      class="font-serif text-lg lowercase text-ink transition-colors hover:text-accent"
    >
      elsa
    </a>
    <nav class="flex gap-3 sm:gap-6" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "whitespace-nowrap text-[0.85rem] transition-colors hover:text-accent sm:text-[0.92rem]",
              isActive(link.href) ? "text-ink" : "text-muted",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
