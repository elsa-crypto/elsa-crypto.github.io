---
// Single-page nav. Each link points to a section anchor on the homepage.
const links = [
  { href: "#work", label: "work" },
  { href: "#building", label: "building" },
  { href: "#beliefs", label: "beliefs" },
  { href: "#contact", label: "contact" },
];
---

<header
  class="sticky top-0 z-20 border-b border-line/70 bg-paper/85 backdrop-blur-sm"
>
  <div
    class="mx-auto flex h-14 max-w-[820px] items-center justify-between px-5 sm:px-8"
  >
    <a
      href="#top"
      class="font-serif text-lg text-ink transition-colors hover:text-accent"
    >
      elsa cai
    </a>
    <nav class="flex gap-4 sm:gap-6" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-[0.92rem] text-muted transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
