---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import ProjectRow from "../components/ProjectRow.astro";

import { building } from "../data/building";
---

<BaseLayout
  title="work — Elsa Cai"
  description="What Elsa Cai has done: growth at ditto, real-world events, and the things she builds."
>
  <PageHeader title="work">
    growth, events, and a few things i've built.
  </PageHeader>

  <!-- GROWTH -->
  <Section id="growth" title="growth" eyebrow="@ ditto">
    <div class="space-y-1 text-[1.08rem] text-ink">
      <p>took ditto from 4k to 150k users in 12 months.</p>
      <p>campaigns that did 10m+ views.</p>
    </div>
    <p class="mt-3 max-w-prose text-[0.97rem] text-muted">
      mostly creator campaigns, campus communities, and a lot of internet
      posting that probably shouldn't have worked.
    </p>
  </Section>

  <!-- EVENTS -->
  <Section id="events" title="events" eyebrow="irl">
    <p class="text-[1.08rem] text-ink">
      4 blind date yacht parties. 20k+ signups across sf, la, nyc, and boston.
    </p>
    <p class="mt-3 max-w-prose text-[0.97rem] text-muted">
      the point was never the numbers. it was getting people to actually find
      love in person. events are the most raw way i know to bring human
      connection back.
    </p>
  </Section>

  <!-- BUILDING -->
  <Section id="building" title="building" eyebrow="code">
    <p class="mb-5 max-w-prose text-[0.97rem] text-muted">
      sites and tools i've built, mostly teaching myself with claude + cursor.
    </p>
    <div>
      {
        building.map((entry) => (
          <ProjectRow
            name={entry.name}
            description={entry.description}
            status={entry.status}
            href={entry.href}
          />
        ))
      }
    </div>
  </Section>
</BaseLayout>
