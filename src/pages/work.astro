---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import ProjectRow from "../components/ProjectRow.astro";

import { building } from "../data/building";
---

<BaseLayout
  title="work — Elsa Cai"
  description="What Elsa Cai is building — growth, product, and marketing experiments."
>
  <PageHeader title="work" eyebrow="what i make">
    growth, content, events, and product experiments.
  </PageHeader>

  <!-- THINGS I'M BUILDING -->
  <Section id="building" title="things i'm building" eyebrow="in progress">
    <div>
      {
        building.map((entry) => (
          <ProjectRow
            name={entry.name}
            description={entry.description}
            status={entry.status}
            href={entry.href}
          />
        ))
      }
    </div>
    <p class="mt-4 text-[0.92rem] text-faint italic">
      not every one of these is a startup. some are just experiments — that's
      the point.
    </p>
  </Section>
</BaseLayout>
