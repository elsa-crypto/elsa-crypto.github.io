---
import BaseLayout from "../layouts/BaseLayout.astro";

// Edit this array to add, remove, or reorder projects.
const projects = [
  {
    name: "Project One",
    description: "What it is and why it's interesting, in one sentence.",
    href: "https://github.com/elsa-crypto",
  },
  {
    name: "Project Two",
    description: "Another thing you made. Link it to a repo, demo, or post.",
    href: "https://github.com/elsa-crypto",
  },
];
---

<BaseLayout title="Elsa — Projects" description="Things Elsa has built.">
  <h1>Projects</h1>
  <p class="lede">A selection of things I've built and worked on.</p>

  <ul class="card-list">
    {
      projects.map((project) => (
        <li class="card">
          <h3>
            <a href={project.href}>{project.name}</a>
          </h3>
          <p>{project.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
