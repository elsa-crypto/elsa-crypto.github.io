---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { thoughts } from "../../data/thoughts";

const current = thoughts.filter((t) => !t.archived);
const archived = thoughts.filter((t) => t.archived);
---

<BaseLayout
  title="brain dumps — Elsa Cai"
  description="Half-formed thoughts from Elsa Cai."
>
  <PageHeader title="brain dumps" eyebrow="my thoughts" />

  <ul class="mt-8 list-none p-0">
    {
      current.map((t) => (
        <li class="border-b border-line last:border-b-0">
          <a
            href={`/brain-dumps/${t.slug}`}
            class="row-hover group flex items-baseline justify-between gap-4 py-4"
          >
            <span class="text-[1.08rem] text-ink transition-colors group-hover:text-accent">
              {t.title}
            </span>
            {t.date && (
              <span class="shrink-0 text-[0.85rem] text-faint">{t.date}</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  {
    archived.length > 0 && (
      <section class="mt-14">
        <p class="eyebrow">archive</p>
        <ul class="mt-3 list-none p-0">
          {archived.map((t) => (
            <li class="border-b border-line last:border-b-0">
              <a
                href={`/brain-dumps/${t.slug}`}
                class="row-hover group flex items-baseline justify-between gap-4 py-3"
              >
                <span class="text-[0.95rem] text-muted transition-colors group-hover:text-accent">
                  {t.title}
                </span>
                {t.date && (
                  <span class="shrink-0 text-[0.85rem] text-faint">{t.date}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
