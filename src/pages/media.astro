---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import VideoPlayer from "../components/VideoPlayer.astro";

import { videos } from "../data/videos";
---

<BaseLayout
  title="media — Elsa Cai"
  description="Elsa Cai's creative work: turning ideas into things people can feel."
>
  <PageHeader title="media">
    <p>i turn ideas into things people can feel.</p>
    <p class="mt-2">
      i make videos for fun. director and producer or anything in between. just
      not an editor.
    </p>
  </PageHeader>

  <div class="mt-10 space-y-10">
    {
      videos.map((v) => (
        <VideoPlayer
          src={v.src}
          poster={v.poster}
          aspect={v.aspect}
          caption={v.caption}
        />
      ))
    }
  </div>
</BaseLayout>
