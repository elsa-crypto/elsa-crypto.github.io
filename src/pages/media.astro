---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<BaseLayout
  title="media — Elsa Cai"
  description="Elsa Cai on the internet — writing and content about consumer startups, growth, and internet culture."
>
  <PageHeader title="media" eyebrow="on the internet">
    i use the internet as both a distribution channel and a testing ground.
  </PageHeader>

  <div class="mt-8">
    <div class="body max-w-prose space-y-4 text-muted">
      <p>
        i write about consumer startups, growth, personal branding, internet
        culture, social products, and what i'm learning while becoming more
        technical.
      </p>
      <p>my approach is less "thought leadership" and more:</p>
    </div>
    <ol class="mt-3 max-w-prose space-y-1 text-ink">
      {
        [
          "notice something",
          "have an opinion",
          "test it",
          "post what happened",
          "let the internet argue about it",
        ].map((step, i) => (
          <li class="flex gap-3">
            <span class="font-serif text-accent">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
    <p class="mt-5 text-[0.92rem] text-faint italic">
      audience size shown once verified: [current linkedin / follower metric]
    </p>
    <SocialLinks class="mt-5" />
  </div>
</BaseLayout>
