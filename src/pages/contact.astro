---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<BaseLayout
  title="contact — Elsa Cai"
  description="Get in touch with Elsa Cai — consumer growth, social products, events, collaborations, and interesting people in SF."
>
  <PageHeader title="reach out" eyebrow="say hi">
    i'm always interested in meeting people building consumer products, social
    apps, strange internet projects, and ideas that sound slightly unreasonable
    at first.
  </PageHeader>

  <div class="mt-8">
    <p class="max-w-prose text-[0.95rem] text-faint">
      good reasons to reach out: consumer growth · creative campaigns · social
      products · startup collaborations · events · brand partnerships · side
      projects · interesting people in sf.
    </p>
    <SocialLinks class="mt-6" />
  </div>
</BaseLayout>
